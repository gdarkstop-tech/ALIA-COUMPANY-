{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApiObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::BUCKET_NAME/w/*", "arn:aws:s3:::BUCKET_NAME/r/*"]
    },
    {
      "Sid": "VerificationCanaries",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/v/*"
    },
    {
      "Sid": "VerificationBucketReads",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketVersioning", "s3:GetLifecycleConfiguration"],
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Sid": "KmsForThisBucketOnly",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "KMS_KEY_ARN",
      "Condition": { "StringEquals": { "kms:ViaService": "s3.REGION.amazonaws.com" } }
    }
  ]
}
