{
  "name": "@ghayarly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "review:seed": "tsx --env-file-if-exists=.env src/db/seed-review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@apple/app-store-server-library": "3.1.0",
    "@better-auth/expo": "1.7.7",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@ghayarly/shared": "workspace:*",
    "@google/genai": "2.28.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "google-auth-library": "11.3.0",
    "ioredis": "6.0.0",
    "openai": "7.32.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "pino-pretty": "^13.0.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.4"
  }
}
