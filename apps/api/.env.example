# ---- Dress My Wound API — local development template. Copy to .env and adjust.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:4000
# Browser origins allowed to call the API with credentials (Expo web, admin console)
WEB_ORIGINS=http://localhost:8081,http://localhost:3001,http://127.0.0.1:3001
# Native deep-link scheme of the matching app variant: dressmywound-dev | dressmywound-staging | dressmywound
MOBILE_SCHEME=dressmywound

# Three roles — see scripts/db-bootstrap.sh and docs/SECURITY.md
DATABASE_URL_APP=postgres://ghayarly_app:ghayarly_app_dev@localhost:5432/ghayarly
DATABASE_URL_AUTH=postgres://ghayarly_auth:ghayarly_auth_dev@localhost:5432/ghayarly
# Owner connection: ONLY for migrate/seed scripts. Never provide it to a production server.
DATABASE_URL_OWNER=postgres://ghayarly_owner:ghayarly_owner_dev@localhost:5432/ghayarly

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# required | warn  (production refuses to start unless "required")
MFA_ENFORCEMENT=warn
# Sign-in attempts per minute per IP (production default 5; raised locally for E2E runs)
AUTH_SIGNIN_RATE_LIMIT=60
# Production only: number of reverse proxies (load balancer / CDN) in front of the API. Client IPs
# for rate limits are read this many hops back in X-Forwarded-For; never trust the whole header.
TRUST_PROXY_HOPS=1
# General API limits (ADR 0016). Defaults: 600/min per signed-in account, 300/min per anonymous IP,
# 6000/min per-IP ceiling, 200 photo/document uploads per account per day. Counters live in Redis.
RATE_LIMIT_ACCOUNT_PER_MIN=
RATE_LIMIT_ANON_IP_PER_MIN=
RATE_LIMIT_IP_CEILING_PER_MIN=
UPLOADS_PER_ACCOUNT_PER_DAY=

# Development showcase (synthetic data) and developer outbox. Forbidden in production.
DEMO_MODE=true
DEV_TOOLS_ENABLED=true

# ---- External integrations (leave empty → reported as NOT_CONFIGURED)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Medical image storage (wound registry, ADR 0015). Images are encrypted by the API before storage.
# Development/test: a local encrypted folder (refused in production; a managed bucket is NOT_CONFIGURED).
# Key: openssl rand -base64 32 (empty → a development key derived from BETTER_AUTH_SECRET).
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_DIR=.data/objects
# Signs short-lived image links (required in production; empty in development → derived key)
MEDIA_LINK_SECRET=
# AI providers — business-owned keys, supplied from the secret manager (never committed, never sent
# to the apps). Leave empty → that provider is NOT_CONFIGURED. Prices, models, routes, quotas and the
# monthly budget are configured in the Admin Console (AI control centre), not here.
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
# Qwen: key AND the workspace/region base URL from Model Studio (e.g. https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1)
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=
AI_GROK_API_KEY=
AI_KIMI_API_KEY=
# MedGemma: company-operated OpenAI-compatible endpoint (https in production) and its bearer key
AI_MEDGEMMA_BASE_URL=
AI_MEDGEMMA_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000
