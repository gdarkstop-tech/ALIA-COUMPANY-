# ---- Ghayarly API — local development template. Copy to .env and adjust.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:4000
# Browser origins allowed to call the API with credentials (Expo web, admin console)
WEB_ORIGINS=http://localhost:8081,http://localhost:3001,http://127.0.0.1:3001
MOBILE_SCHEME=ghayarly

# Three roles — see scripts/db-bootstrap.sh and docs/SECURITY.md
DATABASE_URL_APP=postgres://ghayarly_app:ghayarly_app_dev@localhost:5432/ghayarly
DATABASE_URL_AUTH=postgres://ghayarly_auth:ghayarly_auth_dev@localhost:5432/ghayarly
# Owner connection: ONLY for migrate/seed scripts. Never provide it to a production server.
DATABASE_URL_OWNER=postgres://ghayarly_owner:ghayarly_owner_dev@localhost:5432/ghayarly

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# required | warn  (production refuses to start unless "required")
MFA_ENFORCEMENT=warn

# Development showcase (synthetic data) and developer outbox. Forbidden in production.
DEMO_MODE=true
DEV_TOOLS_ENABLED=true

# ---- External integrations (leave empty → reported as NOT_CONFIGURED)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AI_PROVIDER=
AI_API_KEY=
