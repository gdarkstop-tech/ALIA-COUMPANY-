{
  "expo": {
    "name": "Ghayarly",
    "slug": "ghayarly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ghayarly",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.ghayarly.app",
      "supportsTablet": true,
      "infoPlist": { "CFBundleAllowMixedLocalizations": true }
    },
    "android": {
      "package": "com.ghayarly.app",
      "adaptiveIcon": { "backgroundColor": "#16746E", "foregroundImage": "./assets/icon.png" },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Ghayarly — Dress My Wound"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        { "backgroundColor": "#FAF8F4", "image": "./assets/splash.png", "imageWidth": 120, "dark": { "backgroundColor": "#08131F" } }
      ]
    ],
    "extra": { "supportsRTL": true },
    "experiments": { "typedRoutes": false }
  }
}
