{
  "name": "ghayarly",
  "private": true,
  "description": "Dress My Wound (\u063a\u064a\u0631 \u0644\u064a) \u2014 premium healthcare & home-care platform. Monorepo.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@ghayarly/api --filter=@ghayarly/admin --filter=@ghayarly/mobile",
    "dev:api": "pnpm --filter @ghayarly/api dev",
    "dev:admin": "pnpm --filter @ghayarly/admin dev",
    "dev:mobile": "pnpm --filter @ghayarly/mobile start",
    "dev:web": "pnpm --filter @ghayarly/mobile web",
    "db:bootstrap": "bash scripts/db-bootstrap.sh",
    "db:migrate": "pnpm --filter @ghayarly/api db:migrate",
    "db:seed": "pnpm --filter @ghayarly/api db:seed",
    "db:reset": "pnpm --filter @ghayarly/api db:reset",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "pnpm --filter @ghayarly/e2e e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "release:check": "node --no-warnings scripts/release/check.ts",
    "brand:assets": "node --no-warnings scripts/brand/generate-assets.ts && python3 scripts/brand/flatten-icon.py apps/mobile/assets/icon.png && python3 scripts/brand/flatten-icon.py --rgba store/assets/google-play/icon-512.png"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "typescript": "~6.0.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0"
  }
}
